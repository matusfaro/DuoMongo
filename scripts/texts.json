 },
 {
  "text": "Би нүүрээ угаана",
  "file": "7ff74ea8f878.mp3"
 },
 {
  "text": "дээл",
  "file": "2d12b1d7bdd6.mp3"
 },
 {
  "text": "цамц",
  "file": "26de2f2802c7.mp3"
 },
 {
  "text": "өмд",
  "file": "8a05dbed92cc.mp3"
 },
 {
  "text": "гутал",
  "file": "67f33d0ae27b.mp3"
 },
 {
  "text": "малгай",
  "file": "140290c98df8.mp3"
 },
 {
  "text": "оймс",
  "file": "e6a309be1d26.mp3"
 },
 {
  "text": "цүнх",
  "file": "b1bc63c6cd36.mp3"
 },
 {
  "text": "өмсөх",
  "file": "412e61c21eed.mp3"
 },
 {
  "text": "хувцас",
  "file": "191d920f5692.mp3"
 },
 {
  "text": "Би дээл өмсөж байна",
  "file": "ab9868baa528.mp3"
 },
 {
  "text": "Энэ шинэ цамц",
  "file": "8833f7f94ff0.mp3"
 },
 {
  "text": "Миний гутал хар",
  "file": "080aa4a51948.mp3"
 },
 {
  "text": "Тэр улаан малгай өмсөж байна",
  "file": "42a4b10746fc.mp3"
 },
 {
  "text": "Чиний цүнх хаана байна?",
  "file": "aa332f26145a.mp3"
 },
 {
  "text": "Өвлийн хувцас өмсөөрэй",
  "file": "b4089fdf95ed.mp3"
 },
 {
  "text": "Өнөөдөр хүйтэн байна, малгай өмсөөрэй",
  "file": "e8792aa98ec5.mp3"
 },
 {
  "text": "Миний цамц цэнхэр",
  "file": "99771d3ac1cb.mp3"
 },
 {
  "text": "Тэр хар өмд өмсөж байна",
  "file": "96d7f59b53b7.mp3"
 },
 {
  "text": "Чиний оймс хаана байна?",
  "file": "2558028a9d35.mp3"
 },
 {
  "text": "Энэ хэний малгай вэ?",
  "file": "a29ca235aabf.mp3"
 },
 {
  "text": "Би дээлд дуртай",
  "file": "9ebc8802e0d2.mp3"
 },
 {
  "text": "явсан",
  "file": "d9d7d2cded0b.mp3"
 },
 {
  "text": "ирсэн",
  "file": "73b65aa6d4f1.mp3"
 },
 {
  "text": "идсэн",
  "file": "9cdbfa641d72.mp3"
 },
 {
  "text": "уусан",
  "file": "db94565e9b51.mp3"
 },
 {
  "text": "уншсан",
  "file": "0a0ce1b6b63d.mp3"
 },
 {
  "text": "явна",
  "file": "ce8dd3f6f9be.mp3"
 },
 {
  "text": "ирнэ",
  "file": "fea9d1b0b7ad.mp3"
 },
 {
  "text": "үзсэн",
  "file": "ae0cb7a278bf.mp3"
 },
 {
  "text": "хийсэн",
  "file": "4c86bfdc7d5e.mp3"
 },
 {
  "text": "кино",
  "file": "4b84fb1d90cb.mp3"
 },
 {
  "text": "Би өчигдөр сургуульд явсан",
  "file": "9a33e9b57c56.mp3"
 },
 {
  "text": "Аав өглөө ирсэн",
  "file": "69c8381f7c64.mp3"
 },
 {
  "text": "Би бууз идсэн",
  "file": "432cee8c952a.mp3"
 },
 {
  "text": "Чи юу хийсэн бэ?",
  "file": "b7ca44c2df60.mp3"
 },
 {
  "text": "Бид маргааш хотод явна",
  "file": "90924ea3fb64.mp3"
 },
 {
  "text": "Тэр ном уншсан",
  "file": "089e364d40ca.mp3"
 },
 {
  "text": "Би цай уусан",
  "file": "0b207583fd91.mp3"
 },
 {
  "text": "Бид өчигдөр хотод явсан",
  "file": "418c8a52c395.mp3"
 },
 {
  "text": "Ээж бууз хийсэн",
  "file": "6f4bc66b64b1.mp3"
 },
 {
  "text": "Би өглөө цай уудаг",
  "file": "1ff59a95b1ec.mp3"
 },
 {
  "text": "Чи хэзээ ирсэн бэ?",
  "file": "cf3cebc1eb95.mp3"
 },
 {
  "text": "Аав мах идсэн, би будаа идсэн",
  "file": "31a73342a387.mp3"
 },
 {
  "text": "Чи кино үзсэн үү?",
  "file": "80902108ad6b.mp3"
 },
 {
  "text": "Би маргааш эмнэлэгт явна",
  "file": "b882480542fd.mp3"
 },
 {
  "text": "Тэд өглөө ирсэн",
  "file": "5e8f4584e590.mp3"
 },
 {
  "text": "Чи өчигдөр юу хийсэн бэ?",
  "file": "8970dd157572.mp3"
 },
 {
  "text": "Би ном уншсан",
  "file": "d70b634fc25f.mp3"
 },
 {
  "text": "Тийм, би кино үзсэн",
  "file": "4e4c329a5e4c.mp3"
 },
 {
  "text": "намайг",
  "file": "217ed95119f8.mp3"
 },
 {
  "text": "гэдэг",
  "file": "44353009601c.mp3"
 },
 {
  "text": "ойлгох",
  "file": "a909e4cf046a.mp3"
 },
 {
  "text": "хэл",
  "file": "8d825cd719cb.mp3"
 },
 {
  "text": "англи",
  "file": "f7985c8e91e6.mp3"
 },
 {
  "text": "туслаач",
  "file": "74a69a347a35.mp3"
 },
 {
  "text": "ямар үнэтэй",
  "file": "f32b5276e1cf.mp3"
 },
 {
  "text": "дахиад",
  "file": "e9547141ec47.mp3"
 },
 {
  "text": "уулзъя",
  "file": "223a6316d1ab.mp3"
 },
 {
  "text": "Би ойлгохгүй байна",
  "file": "149ad03461bd.mp3"
 },
 {
  "text": "Та англиар ярьдаг уу?",
  "file": "dd1696e5fb1a.mp3"
 },
 {
  "text": "Би монголоор жаахан ярьдаг",
  "file": "0f365acaac64.mp3"
 },
 {
  "text": "Энэ ямар үнэтэй вэ?",
  "file": "decb1268cfab.mp3"
 },
 {
  "text": "Дахиад хэлээрэй",
  "file": "81b5667a23ee.mp3"
 },
 {
  "text": "Би Монголд дуртай",
  "file": "f62ee1a0992e.mp3"
 },
 {
  "text": "Таныг хэн гэдэг вэ?",
  "file": "13f775fb5606.mp3"
 },
 {
  "text": "Намайг Сараа гэдэг",
  "file": "871096ccd619.mp3"
 },
 {
  "text": "Би англиар ярьдаг",
  "file": "73905b774bb9.mp3"
 },
 {
  "text": "Жаахан удаан яриарай",
  "file": "e0c70261dea5.mp3"
 },
 {
  "text": "Надад туслаач",
  "file": "78bbcac85485.mp3"
 },
 {
  "text": "Монголоор юу гэдэг вэ?",
  "file": "a941956d45df.mp3"
 },
 {
  "text": "Би ойлгосон",
  "file": "44204b9c278b.mp3"
 },
 {
  "text": "Дахиад уулзъя",
  "file": "73c9b35e913b.mp3"
 },
 {
  "text": "хорь",
  "file": "5e7fd8fed330.mp3"
 },
 {
  "text": "гуч",
  "file": "a66bc49738ca.mp3"
 },
 {
  "text": "дөч",
  "file": "8965afd1221b.mp3"
 },
 {
  "text": "тавь",
  "file": "3348a3aa8b05.mp3"
 },
 {
  "text": "жар",
  "file": "c28b67d0351a.mp3"
 },
 {
  "text": "дал",
  "file": "c1d99969cddf.mp3"
 },
 {
  "text": "ная",
  "file": "b0c247e9d724.mp3"
 },
 {
  "text": "ер",
  "file": "29f97d522ca2.mp3"
 },
 {
  "text": "мянга",
  "file": "31ea396c4353.mp3"
 },
 {
  "text": "төгрөг",
  "file": "7fa167b2956f.mp3"
 },
 {
  "text": "мөнгө",
  "file": "34aa2b26ba2e.mp3"
 },
 {
  "text": "үнэ",
  "file": "527b6eb200b9.mp3"
 },
 {
  "text": "настай",
  "file": "c074044f8060.mp3"
 },
 {
  "text": "Энэ хэдэн төгрөг вэ?",
  "file": "36f08050962d.mp3"
 },
 {
  "text": "Мянган төгрөг",
  "file": "81167a39b702.mp3"
 },
 {
  "text": "Хорин нэг",
  "file": "aa0798dee64e.mp3"
 },
 {
  "text": "Надад мөнгө байна",
  "file": "c8411c93f8b5.mp3"
 },
 {
  "text": "Үнэ хэд вэ?",
  "file": "08e49df4bfd5.mp3"
 },
 {
  "text": "Тавин төгрөг байна",
  "file": "55292a02293c.mp3"
 },
 {
  "text": "Чи хэдэн настай вэ?",
  "file": "af30d30dc2b9.mp3"
 },
 {
  "text": "Би гучин настай",
  "file": "36b3027e162d.mp3"
 },
 {
  "text": "Миний өвөө жаран настай",
  "file": "72389109adcc.mp3"
 },
 {
  "text": "Энэ хоёр мянган төгрөг",
  "file": "2e1d7885fd05.mp3"
 },
 {
  "text": "Гучин хүн ирсэн",
  "file": "6dd3c7c01e17.mp3"
 },
 {
  "text": "Надад тавин төгрөг байна",
  "file": "a7e6a8149d7b.mp3"
 },
 {
  "text": "Даваа",
  "file": "e6eb845e7edf.mp3"
 },
 {
  "text": "Мягмар",
  "file": "828ee19ba3ee.mp3"
 },
 {
  "text": "Лхагва",
  "file": "40c7911d64d1.mp3"
 },
 {
  "text": "Пүрэв",
  "file": "ae2b2a66bab1.mp3"
 },
 {
  "text": "Баасан",
  "file": "531fc1248675.mp3"
 },
 {
  "text": "Бямба",
  "file": "4178ba4515cb.mp3"
 },
 {
  "text": "Ням",
  "file": "53f593ad28e4.mp3"
 },
 {
  "text": "гараг",
  "file": "bfec4c85e986.mp3"
 },
 {
  "text": "долоо хоног",
  "file": "16489d2be117.mp3"
 },
 {
  "text": "амрах",
  "file": "7e7c93dae3e1.mp3"
 },
 {
  "text": "Өнөөдөр Даваа гараг",
  "file": "1ae7c676f6d0.mp3"
 },
 {
  "text": "Маргааш Бямба гараг",
  "file": "31be5f4b50f2.mp3"
 },
 {
  "text": "Би Баасан гарагт явна",
  "file": "deea47092836.mp3"
 },
 {
  "text": "Ням гарагт би гэртээ байна",
  "file": "caa2fabc1bc3.mp3"
 },
 {
  "text": "Өчигдөр Пүрэв гараг байсан",
  "file": "ba9161e8a165.mp3"
 },
 {
  "text": "Өнөөдөр Лхагва гараг",
  "file": "97df8110a0a2.mp3"
 },
 {
  "text": "Долоо хоногт долоон өдөр байна",
  "file": "2d9a5368d14f.mp3"
 },
 {
  "text": "Би Ням гарагт амардаг",
  "file": "494bfa35cf53.mp3"
 },
 {
  "text": "Маргааш Мягмар гараг уу?",
  "file": "c38c3d255258.mp3"
 },
 {
  "text": "Үгүй, маргааш Лхагва гараг",
  "file": "501cc2771aba.mp3"
 },
 {
  "text": "Би Мягмар гарагт сургуульд явдаг",
  "file": "da7a91671324.mp3"
 },
 {
  "text": "авах",
  "file": "2770f567ee12.mp3"
 },
 {
  "text": "зарах",
  "file": "fc7c94ba44fd.mp3"
 },
 {
  "text": "үнэтэй",
  "file": "1011a037b4f4.mp3"
 },
 {
  "text": "хямд",
  "file": "9611232057a1.mp3"
 },
 {
  "text": "зах",
  "file": "779217f27a82.mp3"
 },
 {
  "text": "худалдагч",
  "file": "c5eec7ad2ea7.mp3"
 },
 {
  "text": "сонгох",
  "file": "02aad942a793.mp3"
 },
 {
  "text": "Би алим авна",
  "file": "b0f1c9634503.mp3"
 },
 {
  "text": "Энэ их үнэтэй байна",
  "file": "d98f571ed9de.mp3"
 },
 {
  "text": "Хямд байна",
  "file": "9ede65ef3f8f.mp3"
 },
 {
  "text": "Та юу авах вэ?",
  "file": "1037e9833e5d.mp3"
 },
 {
  "text": "Би захад явна",
  "file": "b50607507156.mp3"
 },
 {
  "text": "Ээж талх авсан",
  "file": "c74ecddec005.mp3"
 },
 {
  "text": "Би шинэ дээл авна",
  "file": "7623a2ce54b2.mp3"
 },
 {
  "text": "Энэ малгай ямар үнэтэй вэ?",
  "file": "fc71de5441a9.mp3"
 },
 {
  "text": "Худалдагч талх зарж байна",
  "file": "5d836396f777.mp3"
 },
 {
  "text": "Би захаас алим авсан",
  "file": "cb1fd7a5ef22.mp3"
 },
 {
  "text": "Энэ цүнх хямд байна",
  "file": "cb022318e772.mp3"
 },
 {
  "text": "Та юу зарж байна вэ?",
  "file": "cd85644f419a.mp3"
 },
 {
  "text": "Хоёр мянган төгрөг",
  "file": "d09752d5e52d.mp3"
 },
 {
  "text": "зүүн",
  "file": "2fe9c1653d66.mp3"
 },
 {
  "text": "баруун",
  "file": "d304ed183351.mp3"
 },
 {
  "text": "чигээрээ",
  "file": "97cc624c609e.mp3"
 },
 {
  "text": "эргэх",
  "file": "b563e76a49af.mp3"
 },
 {
  "text": "ойрхон",
  "file": "82bc45df8257.mp3"
 },
 {
  "text": "хол",
  "file": "71b8a8bf15d8.mp3"
 },
 {
  "text": "тийш",
  "file": "8e981761f2f5.mp3"
 },
 {
  "text": "зам",
  "file": "5d4844684574.mp3"
 },
 {
  "text": "Баруун тийш эргэ",
  "file": "79d5e5e115a1.mp3"
 },
 {
  "text": "Зүүн тийш эргэ",
  "file": "de6d81444ffd.mp3"
 },
 {
  "text": "Чигээрээ яв",
  "file": "e1344c517935.mp3"
 },
 {
  "text": "Дэлгүүр ойрхон байна",
  "file": "0d4d5d263b8b.mp3"
 },
 {
  "text": "Сургууль хол байна",
  "file": "7b4821362bed.mp3"
 },
 {
  "text": "Энэ зам хаашаа явдаг вэ?",
  "file": "546be644672e.mp3"
 },
 {
  "text": "Зах хаана байна?",
  "file": "1434b4ed64a8.mp3"
 },
 {
  "text": "Эмнэлэг ойрхон байна уу?",
  "file": "0164a9a6307d.mp3"
 },
 {
  "text": "Үгүй, хол байна",
  "file": "3471e3c59cd8.mp3"
 },
 {
  "text": "Миний гэр сургуулиас хол",
  "file": "bf22a8a1a008.mp3"
 },
 {
  "text": "Та зүүн тийш яваарай",
  "file": "d03cb540c15a.mp3"
 },
 {
  "text": "Дэлгүүр баруун талд байна",
  "file": "a904af31cded.mp3"
 },
 {
  "text": "аз жаргалтай",
  "file": "c97eb1a0547a.mp3"
 },
 {
  "text": "гунигтай",
  "file": "c65a47a2ae96.mp3"
 },
 {
  "text": "ядарсан",
  "file": "b840dcc6e29a.mp3"
 },
 {
  "text": "өлсөх",
  "file": "e6e741677f85.mp3"
 },
 {
  "text": "цангах",
  "file": "922aa58c8eaa.mp3"
 },
 {
  "text": "өвчтэй",
  "file": "11776277cb3f.mp3"
 },
 {
  "text": "эрүүл",
  "file": "d4167786fb00.mp3"
 },
 {
  "text": "айж байна",
  "file": "b69d6cef42d3.mp3"
 },
 {
  "text": "Би өлсөж байна",
  "file": "0366e1b9c1ff.mp3"
 },
 {
  "text": "Би ядарч байна",
  "file": "31e79c302fdd.mp3"
 },
 {
  "text": "Чи цангаж байна уу?",
  "file": "e345a5d338cd.mp3"
 },
 {
  "text": "Тэр өвчтэй байна",
  "file": "1495c92f25fe.mp3"
 },
 {
  "text": "Би их аз жаргалтай байна",
  "file": "4680f1c0892a.mp3"
 },
 {
  "text": "Миний дүү гунигтай байна",
  "file": "ccbd58011a9c.mp3"
 },
 {
  "text": "Би цангаж байна",
  "file": "27f41f418e82.mp3"
 },
 {
  "text": "Чи өлсөж байна уу?",
  "file": "aba5e9b5c132.mp3"
 },
 {
  "text": "Тийм, би их өлсөж байна",
  "file": "05c15a898a46.mp3"
 },
 {
  "text": "Миний найз аз жаргалтай",
  "file": "559dc2369117.mp3"
 },
 {
  "text": "Өвөө эрүүл байна",
  "file": "1c020ef60d8f.mp3"
 },
 {
  "text": "Чи яагаад гунигтай байна вэ?",
  "file": "5e6c1fc1a1ad.mp3"
 },
 {
  "text": "Би ядарсан, одоо унтана",
  "file": "ce9a1798300e.mp3"
 },
 {
  "text": "эмч",
  "file": "c7f7fd2e2048.mp3"
 },
 {
  "text": "жолооч",
  "file": "8e36b4f3ace8.mp3"
 },
 {
  "text": "тогооч",
  "file": "8aa86bc75bb0.mp3"
 },
 {
  "text": "малчин",
  "file": "9220471dd010.mp3"
 },
 {
  "text": "цагдаа",
  "file": "5ba6b3aa0933.mp3"
 },
 {
  "text": "ажил",
  "file": "7d4c70991842.mp3"
 },
 {
  "text": "ажиллах",
  "file": "779a3db75f5e.mp3"
 },
 {
  "text": "дуучин",
  "file": "3f6d16ed4ebf.mp3"
 },
 {
  "text": "Миний ээж эмч",
  "file": "e51df5717f6c.mp3"
 },
 {
  "text": "Аав ажилдаа явсан",
  "file": "8cf7e431fb3b.mp3"
 },
 {
  "text": "Тэр малчин",
  "file": "63d60fd6e24d.mp3"
 },
 {
  "text": "Миний ах жолооч",
  "file": "6941e0efdda7.mp3"
 },
 {
  "text": "Би эмнэлэгт ажилладаг",
  "file": "956aaae4cd89.mp3"
 },
 {
  "text": "Тогооч бууз хийж байна",
  "file": "56f07181cfb5.mp3"
 },
 {
  "text": "Та ямар ажил хийдэг вэ?",
  "file": "445dafbc02a2.mp3"
 },
 {
  "text": "Би багш, сургуульд ажилладаг",
  "file": "770699e930ad.mp3"
 },
 {
  "text": "Эмч эмнэлэгт ажилладаг",
  "file": "dbdc5b038f2f.mp3"
 },
 {
  "text": "Миний дүү дуучин",
  "file": "d0190d5bd365.mp3"
 },
 {
  "text": "Цагдаа гудамжинд байна",
  "file": "7708791255d4.mp3"
 },
 {
  "text": "Тогооч амттай хоол хийдэг",
  "file": "e3908af8d286.mp3"
 },
 {
  "text": "Малчин талд ажилладаг",
  "file": "1a8948238222.mp3"
 },
 {
  "text": "Би эмч",
  "file": "5c912658433d.mp3"
 },
 {
  "text": "Намайг Бат гэдэг. Таны нэр хэн бэ?",
  "file": "1a760bee485d.mp3"
 },
 {
  "text": "Би Улаанбаатараас ирсэн. Та монголоор сайн ярьдаг!",
  "file": "aa3f8ef0054e.mp3"
 },
 {
  "text": "Баярлалаа. Би монгол хэл сурч байна",
  "file": "be11abb7b774.mp3"
 },
 {
  "text": "Би цай ууна. Та юу уух вэ?",
  "file": "3ca567c9c4d7.mp3"
 },
 {
  "text": "Би сүүтэй цай ууна",
  "file": "6441896efbdf.mp3"
 },
 {
  "text": "Та өлсөж байна уу?",
  "file": "f398336e29f5.mp3"
 },
 {
  "text": "Энд бууз их амттай",
  "file": "723de998c6e3.mp3"
 },
 {
  "text": "За, би бууз иднэ. Хуушуур амттай юу?",
  "file": "3011d710c3f3.mp3"
 },
 {
  "text": "Тийм! Хоёулаа авъя",
  "file": "0cb6f2618932.mp3"
 },
 {
  "text": "Хоол амттай байсан. Бат баяртай байна",
  "file": "64b8b8908c43.mp3"
 },
 {
  "text": "Энэ хэн бэ?",
  "file": "d92062d44783.mp3"
 },
 {
  "text": "Энэ миний аав. Тэр малчин",
  "file": "85b018e7435d.mp3"
 },
 {
  "text": "Танай аав хаана суудаг вэ?",
  "file": "18e1d999dd5c.mp3"
 },
 {
  "text": "Аав ээж хоёр тал нутагт суудаг",
  "file": "bf9a0d37bc6b.mp3"
 },
 {
  "text": "Тэдэнд морь байна уу?",
  "file": "b8459ab74675.mp3"
 },
 {
  "text": "Тийм, олон морь, хонь, ямаа байна",
  "file": "2ae5e3e7e805.mp3"
 },
 {
  "text": "Сайхан! Би тал нутагт очмоор байна",
  "file": "7b452b96e639.mp3"
 },
 {
  "text": "Бямба гараг. Бат захад явна",
  "file": "d40c3257433c.mp3"
 },
 {
  "text": "Хорин мянган төгрөг",
  "file": "eae277211d7c.mp3"
 },
 {
  "text": "Их үнэтэй байна!",
  "file": "253146a5122b.mp3"
 },
 {
  "text": "За, арван мянга. Хямд байна",
  "file": "9186598869a0.mp3"
 },
 {
  "text": "За, би авна. Баярлалаа!",
  "file": "740eaeb71902.mp3"
 },
 {
  "text": "Одоо Батад шинэ малгай байна",
  "file": "ba7be6517d61.mp3"
 }
]