 },
 {
  "text": "Намайг Бат гэдэг. Таны нэр хэн бэ?",
  "file": "1a760bee485d.mp3"
 },
 {
  "text": "Намайг Сараа гэдэг",
  "file": "871096ccd619.mp3"
 },
 {
  "text": "Би Улаанбаатараас ирсэн. Та монголоор сайн ярьдаг!",
  "file": "aa3f8ef0054e.mp3"
 },
 {
  "text": "Баярлалаа. Би монгол хэл сурч байна",
  "file": "be11abb7b774.mp3"
 },
 {
  "text": "Би цай ууна. Та юу уух вэ?",
  "file": "3ca567c9c4d7.mp3"
 },
 {
  "text": "Би сүүтэй цай ууна",
  "file": "6441896efbdf.mp3"
 },
 {
  "text": "Та өлсөж байна уу?",
  "file": "f398336e29f5.mp3"
 },
 {
  "text": "Тийм, би их өлсөж байна",
  "file": "05c15a898a46.mp3"
 },
 {
  "text": "Энд бууз их амттай",
  "file": "723de998c6e3.mp3"
 },
 {
  "text": "За, би бууз иднэ. Хуушуур амттай юу?",
  "file": "3011d710c3f3.mp3"
 },
 {
  "text": "Тийм! Хоёулаа авъя",
  "file": "0cb6f2618932.mp3"
 },
 {
  "text": "Хоол амттай байсан. Бат баяртай байна",
  "file": "64b8b8908c43.mp3"
 },
 {
  "text": "Энэ хэн бэ?",
  "file": "d92062d44783.mp3"
 },
 {
  "text": "Энэ миний аав. Тэр малчин",
  "file": "85b018e7435d.mp3"
 },
 {
  "text": "Танай аав хаана суудаг вэ?",
  "file": "18e1d999dd5c.mp3"
 },
 {
  "text": "Аав ээж хоёр тал нутагт суудаг",
  "file": "bf9a0d37bc6b.mp3"
 },
 {
  "text": "Тэдэнд морь байна уу?",
  "file": "b8459ab74675.mp3"
 },
 {
  "text": "Тийм, олон морь, хонь, ямаа байна",
  "file": "2ae5e3e7e805.mp3"
 },
 {
  "text": "Сайхан! Би тал нутагт очмоор байна",
  "file": "7b452b96e639.mp3"
 },
 {
  "text": "Бямба гараг. Бат захад явна",
  "file": "d40c3257433c.mp3"
 },
 {
  "text": "Энэ малгай ямар үнэтэй вэ?",
  "file": "fc71de5441a9.mp3"
 },
 {
  "text": "Хорин мянган төгрөг",
  "file": "eae277211d7c.mp3"
 },
 {
  "text": "Их үнэтэй байна!",
  "file": "253146a5122b.mp3"
 },
 {
  "text": "За, арван мянга. Хямд байна",
  "file": "9186598869a0.mp3"
 },
 {
  "text": "За, би авна. Баярлалаа!",
  "file": "740eaeb71902.mp3"
 },
 {
  "text": "Одоо Батад шинэ малгай байна",
  "file": "ba7be6517d61.mp3"
 }
]