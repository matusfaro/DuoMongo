  "text": "Цай халуун байна",
  "file": "bd9950f60c7c.mp3"
 },
 {
  "text": "Өнөөдөр их хүйтэн байна",
  "file": "5c6049465de6.mp3"
 },
 {
  "text": "Миний нохой жижиг",
  "file": "c890f1b0aaef.mp3"
 },
 {
  "text": "Шинэ ном сайхан",
  "file": "2c8dd70018e8.mp3"
 },
 {
  "text": "Морь хурдан, тэмээ удаан",
  "file": "716ca3a0b9f3.mp3"
 },
 {
  "text": "бид",
  "file": "0c7fcc0d63a5.mp3"
 },
 {
  "text": "тэд",
  "file": "53395681fb76.mp3"
 },
 {
  "text": "таны",
  "file": "ffa57c13044e.mp3"
 },
 {
  "text": "манай",
  "file": "3d290c533237.mp3"
 },
 {
  "text": "түүний",
  "file": "d5d7b8170459.mp3"
 },
 {
  "text": "хэний",
  "file": "38ee852a3f5c.mp3"
 },
 {
  "text": "хаанаас",
  "file": "a66974e49589.mp3"
 },
 {
  "text": "надад",
  "file": "4b371456228b.mp3"
 },
 {
  "text": "Энэ хэний ном бэ?",
  "file": "1207bfdb2f7c.mp3"
 },
 {
  "text": "Энэ багшийн ном",
  "file": "fae48056bb3d.mp3"
 },
 {
  "text": "Та хаанаас ирсэн бэ?",
  "file": "a37c19403212.mp3"
 },
 {
  "text": "Би Америкаас ирсэн",
  "file": "f0fa717ce1f1.mp3"
 },
 {
  "text": "Манай гэр бүл том",
  "file": "74285fe96c59.mp3"
 },
 {
  "text": "Надад нохой байна",
  "file": "4ef9c5b0ed80.mp3"
 },
 {
  "text": "Түүний нэр Бат",
  "file": "36961f9bf8b1.mp3"
 },
 {
  "text": "цаг агаар",
  "file": "368226923f31.mp3"
 },
 {
  "text": "нар",
  "file": "d43dcab16e69.mp3"
 },
 {
  "text": "бороо",
  "file": "11b348d393d8.mp3"
 },
 {
  "text": "цас",
  "file": "3fa7ca39954f.mp3"
 },
 {
  "text": "салхи",
  "file": "c2681d852167.mp3"
 },
 {
  "text": "үүл",
  "file": "b2a9216508c7.mp3"
 },
 {
  "text": "тэнгэр",
  "file": "57331214fbc5.mp3"
 },
 {
  "text": "орох",
  "file": "320985069987.mp3"
 },
 {
  "text": "Бороо орж байна",
  "file": "74db82afa763.mp3"
 },
 {
  "text": "Цас орж байна",
  "file": "52feb71acaa1.mp3"
 },
 {
  "text": "Өнөөдөр цаг агаар сайхан байна",
  "file": "98c100c0a528.mp3"
 },
 {
  "text": "Нар гарч байна",
  "file": "b4c78678375d.mp3"
 },
 {
  "text": "Салхи хүчтэй байна",
  "file": "dd6cad4890ea.mp3"
 },
 {
  "text": "Тэнгэр хөх байна",
  "file": "49177c94a9a6.mp3"
 },
 {
  "text": "толгой",
  "file": "ed0239b13d33.mp3"
 },
 {
  "text": "нүд",
  "file": "17539efeb201.mp3"
 },
 {
  "text": "чих",
  "file": "fa9433950b3d.mp3"
 },
 {
  "text": "хамар",
  "file": "e0f8aa32989b.mp3"
 },
 {
  "text": "ам",
  "file": "cd2bb8c19024.mp3"
 },
 {
  "text": "гар",
  "file": "04df426494fa.mp3"
 },
 {
  "text": "хөл",
